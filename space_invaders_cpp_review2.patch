+            return;
+        }
+        img_ = true;
+        if (TTF_Init() != 0) {
+            std::fprintf(stderr, "TTF_Init failed: %s\n", TTF_GetError());
+            return;
+        }
+        ttf_ = true;
+
+        /* 音声は任意。使えなくても続行する（WSL・CI など）。
