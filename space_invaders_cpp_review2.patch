+void wait_for_next_frame(Uint64 *next, Uint64 freq)
+{
+    *next += freq / 60;
+    Uint64 t = SDL_GetPerformanceCounter();
+    if (*next > t) {
+        Uint32 ms = static_cast<Uint32>((*next - t) * 1000 / freq);
+        if (ms > 0)
+            SDL_Delay(ms);
+    } else if (t - *next > freq / 10) {
+        /* 大きく遅れたら（ウィンドウ移動など）追いつこうとせず仕切り直す */
+        *next = t;
+    }
