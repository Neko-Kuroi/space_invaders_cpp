+bool Game::blockers_erase_overlap(const SDL_Rect &r)
+{
+    bool hit = false;
+    for (int base = 0; base < BLOCKER_COUNT; base++) {
+        SDL_Rect area = blocker_base_area(base);
+        if (!overlap(r, area))
